{
  "manifest_version": 3,
  "name": "Jacobi — Verified Price Comparison",
  "version": "0.5.0",
  "description": "Find the cheapest verified way to buy the exact product you are viewing. Exact-match, all-in totals, evidence-backed.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jacobi — compare this price"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116"
}

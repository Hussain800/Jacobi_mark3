# JACOBI - Backend Environment Configuration
# Copy this to backend/.env or create .env.local at the repo root.
# Never commit real keys.

# Optional legacy Deep Audit only. Normal price comparison never reads or calls
# these providers. Leave blank for the zero-cost default deployment.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# Set true only after enabling Custom Headers & Cookies on the Bright Data
# Unlocker zone. The app still sends headers either way, but Bright Data may
# disregard them until the zone feature is enabled.
BRIGHTDATA_CUSTOM_HEADERS_ENABLED=false

# AI analysis providers (tried in order: AI/ML API -> Gemini -> OpenCode -> Groq)
AIMLAPI_KEY=your_key_here
AIMLAPI_MODEL=gpt-4o
OPENCODE_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_key_here

# Supabase (project: Jacobi)
SUPABASE_URL=your_url_here
SUPABASE_SERVICE_KEY=your_key_here
SUPABASE_ANON_KEY=your_key_here
# Also read as fallbacks by backend modules:
NEXT_PUBLIC_SUPABASE_URL=your_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_key_here

# Stripe billing (required for /api/billing endpoints)
# Use TEST mode keys (sk_test_*) for the hackathon demo — judges can complete
# checkout with card 4242 4242 4242 4242. The publishable key (pk_test_*)
# belongs in frontend/.env.local, not here.
STRIPE_SECRET_KEY=your_key_here
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxx
# Set after creating the webhook endpoint in Stripe Dashboard (whsec_*).
STRIPE_WEBHOOK_SECRET=your_key_here

# Frontend origin used to build Stripe redirect URLs (success/cancel pages).
FRONTEND_URL=http://localhost:3000

# TriggerWare.ai webhook (fires probe-completed events into downstream workflows)
TRIGGERWARE_WEBHOOK_URL=your_webhook_url_here

# Monthly probe quotas (matches hackathon-facing pricing page).
# NOTE: PRO_MONTHLY_PROBES is stored on the profile but not yet enforced —
# can_run_probe() still treats tier=="pro" as unconditionally allowed.
# Wire enforcement post-hackathon (see profile_store.py for full TODO).
FREE_MONTHLY_PROBES=24
PRO_MONTHLY_PROBES=50

# Sentry error tracking (optional — leave blank to disable)
SENTRY_DSN=

# ── Jacobi for Agents (price provenance layer, /api/v1/agent/*) ─────────────
# All optional — the agent verification layer runs with safe defaults.

# Per-process spend ceiling for managed collection providers (USD). Local and
# fixture providers cost $0, so this only bites once paid adapters are added;
# the budget_blocked decision path is wired and tested today.
JACOBI_AGENT_BUDGET_USD=5.0

# Where LocalHttpProvider stores raw HTML evidence artifacts.
# Default: backend/agentcore/_artifacts (gitignored).
JACOBI_ARTIFACT_DIR=

# Cap on stored HTML artifacts (oldest pruned first). Bounds disk growth from
# unauthenticated verify calls.
JACOBI_ARTIFACT_MAX_FILES=500

# Rate limit for /api/v1/agent/verify and /compare-total-price
# (per API key when authenticated, per IP otherwise).
JACOBI_AGENT_RATE_LIMIT_PER_MIN=30

# API keys for the agent endpoints: "key1:org1,key2:org2". When set, custom-URL
# verifications require the X-Api-Key header (fixture demos stay keyless).
# Unset = keyless dev-open mode.
JACOBI_AGENT_API_KEYS=

# Provenance storage: memory (default, dev-only, forgotten on restart) or
# supabase (needs SUPABASE_URL/SUPABASE_SERVICE_KEY + the
# agent_provenance_records migration).
JACOBI_AGENT_STORAGE=memory

# Price-optimization persistence. "memory" is bounded local development;
# "supabase" is explicit and fails closed unless the production client exists.
JACOBI_COMPARE_STORAGE=memory
JACOBI_COMPARE_RATE_LIMIT_PER_MIN=30

# Privacy-conscious comparison events are local/no-op unless explicitly enabled.
JACOBI_COMPARE_TELEMETRY_ENABLED=false

# Comma-separated frontend/extension origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Optional Playwright browser evidence (pip install playwright && python -m
# playwright install chromium). 0 disables even when installed.
JACOBI_ENABLE_PLAYWRIGHT=0
# Keep Playwright trace zips as evidence artifacts (heavier).
JACOBI_PLAYWRIGHT_TRACE=0

# Set 1 ONLY when the backend runs behind a trusted reverse proxy — makes the
# rate limiter honor X-Forwarded-For for anonymous callers.
JACOBI_TRUSTED_PROXY=0

# Optional HMAC-SHA256 signing key for evidence manifests. When set, every
# manifest carries signature = HMAC(key, manifest_sha256).
JACOBI_MANIFEST_SIGNING_KEY=

# Optional JSON overrides for the platform policy registry, e.g.
# {"trusted-partner.example": "purchase_authorized_allowed"}
# Action modes: evidence_only | recommendation_allowed |
#               checkout_prepare_allowed | purchase_authorized_allowed | blocked
JACOBI_POLICY_OVERRIDES=

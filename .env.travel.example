# Copy to .env for Docker Compose. Never commit the copied file or real values.

# Local container ports and PostgreSQL schema-validation database.
POSTGRES_DB=jacobi
POSTGRES_USER=jacobi
POSTGRES_PASSWORD=jacobi_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000

# Default local mode: one API process, Redis coordination, inline worker, and
# bounded in-memory travel records. This is not durable across API restarts.
APP_ENV=development
JACOBI_TRAVEL_STORAGE=memory
JACOBI_TRAVEL_RUNTIME=redis
JACOBI_TRAVEL_INLINE_WORKER=1
REDIS_URL=redis://redis:6379/0
JACOBI_TRAVEL_CAPABILITY_SECRET=replace-with-at-least-32-random-bytes
JACOBI_TRAVEL_RATE_LIMIT_PER_MIN=30
JACOBI_TRAVEL_TELEMETRY_ENABLED=false

# Distributed API + worker mode requires shared Supabase storage. Set these,
# change JACOBI_TRAVEL_STORAGE=supabase and JACOBI_TRAVEL_INLINE_WORKER=0, then
# start Compose with --profile distributed. Agentcore evidence must also use
# shared Supabase storage so manifests written by workers are readable by API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Amadeus sandbox is the safe default. Credentials are server-only and optional;
# without both, Amadeus is reported as unconfigured. Production additionally
# requires AMADEUS_ENVIRONMENT=production and AMADEUS_PRODUCTION_APPROVED=1.
AMADEUS_ENVIRONMENT=sandbox
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_PRODUCTION_APPROVED=0
AMADEUS_TIMEOUT_SECONDS=8

# Explicit comma-separated browser origins. Add the final, fixed
# chrome-extension://<extension-id> origin after packaging/install assignment.
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=replace-for-any-authenticated-frontend-deployment

# Existing retail comparison and Agentcore stores remain independently selected.
JACOBI_COMPARE_STORAGE=memory
JACOBI_AGENT_STORAGE=memory
JACOBI_MANIFEST_SIGNING_KEY=

# Optional legacy Deep Audit only. Travel comparison never requires Bright Data.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

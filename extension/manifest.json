{
  "manifest_version": 3,
  "name": "Jacobi — Travel Savings Guardian",
  "version": "0.6.0",
  "description": "Compare a supported flight or hotel page against independent evidence, with explicit privacy consent and revalidation before opening a route.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jacobi — check this travel price"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116"
}
